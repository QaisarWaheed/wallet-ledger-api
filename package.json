{
  "name": "wallet-ledger-api",
  "version": "1.0.0",
  "description": "Wallet ledger HTTP API: credit, debit and balance on PostgreSQL, safe under concurrency.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run test:unit",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "loadtest": "node loadtest/run.ts"
  },
  "dependencies": {
    "@fastify/swagger": "^9.9.4",
    "@fastify/swagger-ui": "^5.2.6",
    "fastify": "^5.6.0",
    "pg": "^8.16.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/pg": "^8.15.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "undici": "^7.10.0",
    "vitest": "^3.2.0"
  }
}
